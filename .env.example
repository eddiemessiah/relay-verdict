# --- Attribution (Track 1 credit; only tagged tx count) ----------------------
# Get this from the Celo Builders skill at registration. Set before going live.
NEXT_PUBLIC_ATTRIBUTION_TAG=

# --- Relay server ------------------------------------------------------------
